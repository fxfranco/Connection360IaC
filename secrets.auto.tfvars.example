# ==================================================================================================
# SECRETOS. Copia este archivo como  secrets.auto.tfvars  (Terraform lo carga solo) y completa los valores.
# secrets.auto.tfvars NO se versiona (esta en .gitignore). No pongas comillas simples (') ni saltos de linea
# dentro de los valores. Las contrasenas de bases de datos: solo A-Z a-z 0-9 . _ ~ -  (minimo 12 caracteres).
# ==================================================================================================

# ---------- Docker Hub (solo si los repositorios son privados) ----------
dockerhub_username = ""
dockerhub_token    = ""

# ---------- Bases de datos ----------
postgres_admin_password = ""
apicore_user_password   = ""
mongo_root_password     = ""

# ---------- JWT (minimo 32 caracteres) ----------
jwt_secret = ""

# ---------- Auth0 Management (Connection360.Api) ----------
# La sincronizacion de usuarios (user_sync_* en dev.tfvars) NO necesita secretos nuevos: reutiliza estas credenciales.
# La aplicacion M2M de Auth0 debe tener autorizada la Management API con los scopes: read:users, update:users,
# read:roles, create:role_members y delete:role_members (listar/editar usuarios, listar roles y cambiar el rol de un usuario).
# Sin read:roles (o read:role_members) Auth0 responde 403 "Insufficient scope" al consultar el rol asignado a un usuario.
auth0_domain        = ""
auth0_client_id     = ""
auth0_client_secret = ""

# ---------- Correo (Connection360Notification.Api) ----------
smtp_sender_email    = ""
smtp_password        = ""
smtp_recipient_email = ""

# ---------- APIs externas del ETL ----------
# Deben ser alcanzables DESDE AWS (IP publica, VPN o tunel). Una IP LAN como 192.168.x.x NO es alcanzable desde la nube.
external_apis = {
  BPMS          = { base_url = "", api_key = "" }
  DATALOGS      = { base_url = "", api_key = "" }
  SIM           = { base_url = "", api_key = "" }
  OPENCOMEX     = { base_url = "", api_key = "" }
  ASISCOMEX     = { base_url = "", api_key = "" }
  SYSTEMCARRIER = { base_url = "", api_key = "" }
}
